# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git.

# OpenAI API key — required for main.py (FastAPI web server) and telegram_bot.py
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Telegram Bot Token — required for telegram_bot.py only
# Get yours from @BotFather on Telegram: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=1234567890:AAHyour-telegram-bot-token-here
